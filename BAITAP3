import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Scanner;

// Lớp Sach (không dùng từ khóa public vì đã có public class Test trong cùng 1 file)
class Sach {
    private String maSach;
    private String tieuDe;
    private String tacGia;
    private int namXuatBan;
    private int soLuong;

    public Sach() {
    }

    public Sach(String maSach, String tieuDe, String tacGia, int namXuatBan, int soLuong) {
        this.maSach = maSach;
        this.tieuDe = tieuDe;
        this.tacGia = tacGia;
        this.namXuatBan = namXuatBan;
        this.soLuong = soLuong;
    }

    public String getMaSach() {
        return maSach;
    }

    public void setMaSach(String maSach) {
        this.maSach = maSach;
    }

    public String getTieuDe() {
        return tieuDe;
    }

    public void setTieuDe(String tieuDe) {
        this.tieuDe = tieuDe;
    }

    public String getTacGia() {
        return tacGia;
    }

    public void setTacGia(String tacGia) {
        this.tacGia = tacGia;
    }

    public int getNamXuatBan() {
        return namXuatBan;
    }

    public void setNamXuatBan(int namXuatBan) {
        this.namXuatBan = namXuatBan;
    }

    public int getSoLuong() {
        return soLuong;
    }

    public void setSoLuong(int soLuong) {
        this.soLuong = soLuong;
    }

    public void hienThiThongTin() {
        System.out.printf("%-10s | %-25s | %-20s | %-8d | %-8d%n",
                maSach, tieuDe, tacGia, namXuatBan, soLuong);
    }
}

// Lớp chính chạy chương trình (tên file phải đặt là Test.java)
public class Test {
    public static void main(String[] args) {
        System.setOut(new java.io.PrintStream(System.out, true, StandardCharsets.UTF_8));
        Scanner sc = new Scanner(System.in, "UTF-8");

        ArrayList<Sach> danhSachSach = new ArrayList<>();

        // Tạo sẵn 2 đối tượng mẫu để dễ test
        danhSachSach.add(new Sach("S01", "Dế Mèn Phiêu Lưu Ký", "Tô Hoài", 1941, 15));
        danhSachSach.add(new Sach("S02", "Nhà Giả Kim", "Paulo Coelho", 1988, 20));

        int chon;
        do {
            System.out.println("\n========== QUẢN LÝ SÁCH THƯ VIỆN (OOP) ==========");
            System.out.println("1. Thêm sách mới");
            System.out.println("2. Hiển thị danh sách sách");
            System.out.println("3. Tìm kiếm sách theo mã");
            System.out.println("4. Cập nhật số lượng sách");
            System.out.println("5. Xóa sách theo mã");
            System.out.println("6. Tính tổng số lượng sách trong thư viện");
            System.out.println("0. Thoát");
            System.out.print("Chọn chức năng: ");
            chon = sc.nextInt();
            sc.nextLine();

            switch (chon) {
                case 1: {
                    System.out.print("Nhập mã sách: ");
                    String ma = sc.nextLine();
                    if (timTheoMa(danhSachSach, ma) != null) {
                        System.out.println("Mã sách đã tồn tại, không thể thêm!");
                    } else {
                        System.out.print("Nhập tiêu đề sách: ");
                        String tieuDe = sc.nextLine();

                        System.out.print("Nhập tác giả: ");
                        String tacGia = sc.nextLine();

                        System.out.print("Nhập năm xuất bản: ");
                        int namXB = sc.nextInt();

                        int soLuong;
                        do {
                            System.out.print("Nhập số lượng: ");
                            soLuong = sc.nextInt();
                            if (soLuong < 0) {
                                System.out.println("Số lượng phải lớn hơn hoặc bằng 0, nhập lại!");
                            }
                        } while (soLuong < 0);
                        sc.nextLine();

                        danhSachSach.add(new Sach(ma, tieuDe, tacGia, namXB, soLuong));
                        System.out.println("Đã thêm sách thành công!");
                    }
                    break;
                }

                case 2: {
                    if (danhSachSach.isEmpty()) {
                        System.out.println("Danh sách sách đang trống!");
                    } else {
                        System.out.println("\n=== DANH SÁCH SÁCH TRONG THƯ VIỆN ===");
                        System.out.printf("%-10s | %-25s | %-20s | %-8s | %-8s%n",
                                "Mã sách", "Tiêu đề", "Tác giả", "Năm XB", "Số lượng");
                        System.out.println("----------------------------------------------------------------------------------");
                        for (Sach s : danhSachSach) {
                            s.hienThiThongTin();
                        }
                    }
                    break;
                }

                case 3: {
                    System.out.print("Nhập mã sách cần tìm: ");
                    String maTim = sc.nextLine();
                    Sach ketQua = timTheoMa(danhSachSach, maTim);
                    if (ketQua == null) {
                        System.out.println("Không tìm thấy sách có mã: " + maTim);
                    } else {
                        System.out.println("Tìm thấy sách:");
                        System.out.printf("%-10s | %-25s | %-20s | %-8s | %-8s%n",
                                "Mã sách", "Tiêu đề", "Tác giả", "Năm XB", "Số lượng");
                        ketQua.hienThiThongTin();
                    }
                    break;
                }

                case 4: {
                    System.out.print("Nhập mã sách cần cập nhật số lượng: ");
                    String maSua = sc.nextLine();
                    Sach sachCanSua = timTheoMa(danhSachSach, maSua);
                    if (sachCanSua == null) {
                        System.out.println("Không tìm thấy sách có mã: " + maSua);
                    } else {
                        int slMoi;
                        do {
                            System.out.print("Nhập số lượng mới: ");
                            slMoi = sc.nextInt();
                            if (slMoi < 0) {
                                System.out.println("Số lượng phải lớn hơn hoặc bằng 0, nhập lại!");
                            }
                        } while (slMoi < 0);
                        sc.nextLine();

                        sachCanSua.setSoLuong(slMoi);
                        System.out.println("Đã cập nhật số lượng thành công!");
                    }
                    break;
                }

                case 5: {
                    System.out.print("Nhập mã sách cần xóa: ");
                    String maXoa = sc.nextLine();
                    Sach sachCanXoa = timTheoMa(danhSachSach, maXoa);
                    if (sachCanXoa == null) {
                        System.out.println("Không tìm thấy sách có mã: " + maXoa);
                    } else {
                        danhSachSach.remove(sachCanXoa);
                        System.out.println("Đã xóa sách có mã: " + maXoa);
                    }
                    break;
                }

                case 6: {
                    int tongSoLuong = 0;
                    for (Sach s : danhSachSach) {
                        tongSoLuong += s.getSoLuong();
                    }
                    System.out.println("Tổng số lượng tất cả sách trong thư viện: " + tongSoLuong + " cuốn.");
                    break;
                }

                case 0:
                    System.out.println("Đã thoát chương trình!");
                    break;

                default:
                    System.out.println("Lựa chọn không hợp lệ, vui lòng chọn lại!");
            }
        } while (chon != 0);

        sc.close();
    }

    public static Sach timTheoMa(ArrayList<Sach> danhSach, String ma) {
        for (Sach s : danhSach) {
            if (s.getMaSach().equalsIgnoreCase(ma)) {
                return s;
            }
        }
        return null;
    }
}